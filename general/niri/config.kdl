prefer-no-csd
animations {
    window-resize {
        duration-ms 200
        curve "cubic-bezier" 0.25 0.1 0.25 1.0
    }
    workspace-switch {
        duration-ms 200
        curve "cubic-bezier" 0.25 0.1 0.25 1.0
    }
}
environment

include optional=true "noctalia.kdl"

spawn-at-startup "noctalia"

include "noctalia/alttab.kdl"
include "noctalia/binds.kdl"
include "noctalia/input.kdl"
include "noctalia/layout.kdl"
include "noctalia/outputs.kdl"
include "noctalia/windowrules.kdl"
