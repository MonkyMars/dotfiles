layout {

    focus-ring {
        active-color "#8ba7c1"
        inactive-color "#1a1f23"
        urgent-color "#fd4663"
    }

    border {
        active-color "#8ba7c1"
        inactive-color "#1a1f23"
        urgent-color "#fd4663"
    }


    tab-indicator {
        active-color "#8ba7c1"
        inactive-color "#2f4e6a"
        urgent-color "#fd4663"
    }

    insert-hint {
        color "#8ba7c180"
    }
}

recent-windows {
    highlight {
        active-color "#8ba7c1"
        urgent-color "#fd4663"
    }
}
