// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=wr_1789254265853804538 @name=Spotify
window-rule {
    match app-id="Spotify"
    open-floating false
    open-on-workspace "5"
}

// @id=wr_1789251587713484181 @name=Vesktop
window-rule {
    match app-id="vesktop"
    open-floating false
    open-on-workspace "5"
}

// @id=wr_1792596249506444891 @name=feishin
window-rule {
    match app-id="^feishin$"
    open-on-workspace "5"
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}
