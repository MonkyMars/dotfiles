window-rule {
    match app-id="^feishin$"
    open-on-workspace "5"
}

window-rule {
    match app-id="game-launcher"
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id="package-helper"
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id="chrome-nngceckbapebfimnlniiiahkandclblb-Default"
    open-floating true
    default-column-width { fixed 400; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id="Spotify"
    open-floating false
    open-on-workspace "5"
}

window-rule {
    match app-id="vesktop"
    open-floating false
    open-on-workspace "5"
}

window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

debug {
    // Allows notification actions and window activation from Noctalia.
    honor-xdg-activation-with-invalid-serial
}

/* Apps: blur them all without xray so it looks more realistic. */
window-rule {
    background-effect {
        blur true
        xray false
    }
}

/*
  Noctalia
  Disable xray on all our surfaces so it looks more realistic.
  Noctalia publishes blur regions automatically when ext-background-effects is available.
*/
layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
        // blur false
    }
}

/* Enable blur on noctalia's window switcher and disable xray. */
layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}

blur {
    passes 2        // more passes = stronger blur (default: 3)
    offset 3.0      // sample distance per pass (default: 3.0)
    noise 0.03      // grain overlay (default: 0.02)
    saturation 1.0  // color saturation boost (default: 1.5)
}

hotkey-overlay {
    skip-at-startup
}
