output "DP-1" {
    mode "2560x1440@239.992"
    scale 1
    position x=1920 y=0
    focus-at-startup
    hot-corners {
        off
    }
}

output "DP-2" {
    mode "1920x1080@165.003"
    scale 1
    position x=0 y=0
    hot-corners {
        off
    }
}

output "eDP-1" {
    mode "2048x1280@60.001"
    scale 1
    position x=1920 y=0
    variable-refresh-rate
    focus-at-startup
}

workspace "1" {
    open-on-output "DP-1"
}

workspace "2" {
    open-on-output "DP-1"
}

workspace "3" {
    open-on-output "DP-1"
}

workspace "4" {
    open-on-output "DP-1"
}

workspace "5" {
    open-on-output "DP-2"
}

workspace "6" {
    open-on-output "DP-2"
}

workspace "7" {
    open-on-output "DP-2"
}

workspace "8" {
    open-on-output "DP-2"
}

workspace "9" {
    open-on-output "DP-2"
}
