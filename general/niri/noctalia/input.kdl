input {
    focus-follows-mouse max-scroll-amount="0%"

    keyboard
    mouse {
        accel-speed 0.0
        accel-profile "flat"
    }
    touchpad {
        disabled-on-external-mouse

        tap
        accel-speed 0.0
        accel-profile "flat"
        dwt
    }
    trackpoint
}

cursor {
    xcursor-size 18
}
