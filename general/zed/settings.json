{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent_servers": {
      "github-copilot-cli": {
         "type": "registry"
      },
      "hermes-agent": {
        "default_config_options": {
          "edit_approval_policy": "workspace_session"
        },
        "type": "custom",
        "command": "/etc/profiles/per-user/monky/bin/hermes",
        "args": ["acp"]
      }
  },
  "edit_predictions": {
    "provider": "copilot",
    "disabled_globs": ["*.env*"],
  },
  "icon_theme": "Colored Zed Icons Theme Dark",
  "agent": {
    "dock": "right",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.1",
      "enable_thinking": false
    },
    "tool_permissions": {
      "default": "allow",
    },
    "default_profile": "write",
    "default_model": {
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "claude-haiku-4.5",
    },
  },
  "vim_mode": false,
  "base_keymap": "VSCode",
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": "Noctalia Dark Transparent",
  "lsp": {
    "rust-analyzer": {
      "binary": {
        "path": "/usr/bin/rust-analyzer",
      },
    },
  },
}
